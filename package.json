{
  "name": "@ai.all/aiall",
  "version": "1.0.0",
  "description": "Portable AI agent instructions and skills initializer, detector and validator",
  "homepage": "https://github.com/ai-all-ai/aiall#readme",
  "type": "module",
  "bin": {
    "aiall": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/cli.js && node --check src/core.js && node --test",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.{js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.{js,mjs,cjs,json,yml,yaml}\""
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-all-ai/aiall.git"
  },
  "keywords": [
    "ai",
    "agents",
    "instructions",
    "codex",
    "claude",
    "gemini",
    "cursor",
    "skills",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/ai-all-ai/aiall/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
